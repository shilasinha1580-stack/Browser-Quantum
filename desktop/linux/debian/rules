#!/usr/bin/make -f
%:
	dh $@

override_dh_auto_build:
	# Build Quantum Browser with Gecko runtime bindings
	echo "Building Quantum Browser for Linux 64-bit with Mozilla Gecko engine..."

override_dh_auto_install:
	install -d debian/quantum-browser/usr/bin
	install -d debian/quantum-browser/usr/lib/quantum-browser
	install -d debian/quantum-browser/usr/share/applications
	install -d debian/quantum-browser/usr/share/icons/hicolor/128x128/apps
	cp ../../public/logo.png debian/quantum-browser/usr/share/icons/hicolor/128x128/apps/quantum-browser.png
