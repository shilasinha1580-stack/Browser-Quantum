#!/usr/bin/make -f

%:
	dh $@

override_dh_auto_build:
	echo "Building Quantum Browser for Linux 64-bit with Mozilla Gecko engine..."
	mkdir -p bin
	if [ ! -f bin/quantum ]; then \
		echo '#!/bin/sh' > bin/quantum; \
		echo 'exec /usr/lib/quantum-browser/quantum "$$@"' >> bin/quantum; \
		chmod +x bin/quantum; \
	fi

override_dh_auto_install:
	install -d debian/quantum-browser/usr/bin
	install -d debian/quantum-browser/usr/lib/quantum-browser
	install -d debian/quantum-browser/usr/share/applications
	install -d debian/quantum-browser/usr/share/icons/hicolor/128x128/apps
	cp ../../public/logo.png debian/quantum-browser/usr/share/icons/hicolor/128x128/apps/quantum-browser.png
	if [ -d runtime ] && [ -f runtime/quantum ]; then \
		cp -a runtime/* debian/quantum-browser/usr/lib/quantum-browser/; \
	else \
		echo "ERROR: Standalone Mozilla Gecko runtime not found in desktop/linux/runtime" >&2; \
		exit 1; \
	fi
	install -m 755 bin/quantum debian/quantum-browser/usr/bin/quantum-browser
	install -m 644 quantum-browser.desktop debian/quantum-browser/usr/share/applications/quantum-browser.desktop

