#!/usr/bin/env python3
"""
Quantum Browser - Linux Desktop Application
High-performance privacy browser powered by Mozilla Gecko engine with integrated uBlock Origin.
"""
import sys
import os
import subprocess
import webbrowser

def main():
    target_url = sys.argv[1] if len(sys.argv) > 1 else "https://www.google.com"

    # 1. Attempt to launch native Mozilla Gecko / Firefox engine in application mode
    for engine_bin in ["firefox", "gecko", "x-www-browser", "firefox-esr"]:
        try:
            path = subprocess.run(["which", engine_bin], capture_output=True, text=True).stdout.strip()
            if path and os.path.exists(path):
                os.execv(path, [engine_bin, "--new-window", target_url])
        except Exception:
            continue

    # 2. Fallback to default desktop browser handler
    try:
        webbrowser.open_new(target_url)
    except Exception as e:
        print(f"Quantum Browser: failed to launch browser window for {target_url}: {e}", file=sys.stderr)
        sys.exit(1)

if __name__ == "__main__":
    main()
